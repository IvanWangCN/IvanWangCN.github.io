---
import { noteUrl, fmtDate, type Note } from '../lib/notes';

interface Props {
  notes: Note[];
}
const { notes } = Astro.props;
---

<div class="note-list">
  {
    notes.map((note) => (
      <div class="note-row">
        <time datetime={fmtDate(note.data.date)}>{fmtDate(note.data.date)}</time>
        <div>
          <a class="title" href={noteUrl(note)}>{note.data.title}</a>
          {note.data.summary && <p class="summary">{note.data.summary}</p>}
        </div>
      </div>
    ))
  }
</div>
